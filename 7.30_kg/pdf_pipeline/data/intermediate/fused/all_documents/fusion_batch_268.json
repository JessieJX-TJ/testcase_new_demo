  {
    "head": "Ambient Lamp Breathing Command",
    "relation": "conflict",
    "tail": "Ambient Lamp Breathing Command activation_condition (0x1–0xF) vs. Ambient Lamp breathing_activation_condition (0x4–0xF): potential semantic overlap — former implies breathing active for 0x1–0x3; latter restricts to 0x4–0xF. No explicit contradiction but inconsistent granularity.",
    "sources": [
      "inner_lamp_ssts_0462",
      "inner_lamp_ssts_0463"
    ],
    "conflict": true,
    "conflict_note": "Inconsistent activation range definitions: inner_lamp_ssts_0462 allows breathing for Code=0x1–0xF; inner_lamp_ssts_0463 restricts breathing behavior to Code=0x4–0xF. This may reflect versioned logic or different subsystem scopes — requires traceability review."
  }
]