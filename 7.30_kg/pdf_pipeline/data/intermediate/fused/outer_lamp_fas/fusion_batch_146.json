    ],
    "conflict": true,
    "conflict_note": "冗余表述：'RearFogLightFucProsSta参数值为0x1' ≡ 'RearFogLightFucProsSta = 0x1'。已规范化为'RearFogLightFucProsSta' → '0x1'，本条被合并。"
  },
  {
    "head": "RearFogLightFucProsSta",
