# Web applications
APP_HOST=0.0.0.0
APP_PORT=4000
FLASK_DEBUG=false
KG_WORKBENCH_URL=http://127.0.0.1:8501

# Neo4j
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Local OpenAI-compatible Qwen services
MODEL_MODE=service
LOCAL_MODEL_API_KEY=EMPTY
QWEN3_4B_SERVICE_HOST=127.0.0.1
QWEN3_4B_SERVICE_PORT=9004
QWEN3_4B_SERVED_MODEL_NAME=Qwen3-4B
QWEN3_4B_LORA_NAME=gen
QWEN3_17B_SERVICE_HOST=127.0.0.1
QWEN3_17B_SERVICE_PORT=9017
QWEN3_17B_SERVED_MODEL_NAME=Qwen3-1.7B
QWEN3_17B_LORA_NAME=critic

# DashScope text, vision, fallback, and embedding models
DASHSCOPE_API_KEY=
DASHSCOPE_QWEN3_8B_MODEL=qwen3-8b
DASHSCOPE_QWEN3_32B_MODEL=qwen3-32b
DASHSCOPE_FALLBACK_MODEL=deepseek-v4-pro-0813
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_MODEL_NAME=text-embedding-v4
EMBEDDING_DIM=1024

# PDF knowledge-graph assets (kept outside Git)
PDF_KG_FINAL_ROOT=

# MinerU is only needed for STS PDF parsing
MINERU_API_TOKEN=
MINERU_BASE_URL=https://mineru.net
MINERU_MODEL_VERSION=vlm
MINERU_TIMEOUT_SECONDS=300
MINERU_POLL_INTERVAL_SECONDS=2

# Optional providers
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEYS=
SILICONFLOW_EMBEDDING_MODEL=
SILICONFLOW_PROXY=

